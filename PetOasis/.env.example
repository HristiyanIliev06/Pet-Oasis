# Copy this file to ".env" (same folder as manage.py) and fill in real values.
# ".env" is git-ignored - never commit it.

# --- Django ---------------------------------------------------------------
# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# True only for local development (also makes runserver serve static/media files)
DJANGO_DEBUG=True
# Comma-separated hosts; defaults to localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL -----------------------------------------------------------
DB_NAME=pet_oasis_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
# Optional: use another Django DB backend, e.g. SQLite for quick local runs/tests
# DB_ENGINE=django.db.backends.sqlite3
